{
  "name": "informes-legales-gore-moquegua",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server.js",
    "dev:web": "npm --prefix frontend run dev",
    "db:setup": "node scripts/run-sql.js",
    "db:migrate": "node scripts/run-sql-migrations.js",
    "informes:reindexar": "node scripts/reindexar-informes.js",
    "admin:reiniciar-clave": "node scripts/reiniciar-clave.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "mssql": "^12.2.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}

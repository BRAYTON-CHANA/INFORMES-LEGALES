# ============================================================
# SIGEA en el servidor del GORE (Debian 13 + docker-compose.yml)
# Copiar como .env en la carpeta del proyecto y completar.
# Guía: docs/despliegue-servidor-linux.md
# ============================================================

# === PostgreSQL 17 (contenedor "db") ===
# La app arma DATABASE_URL con estos datos (docker-compose.yml). Usa una clave SIN símbolos
# (va dentro de una URL): genera una con   openssl rand -hex 24
POSTGRES_DB=sigea
POSTGRES_USER=sigea
POSTGRES_PASSWORD=

# === JWT (sesiones) ===
# Genera uno con   openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h

# === Admin inicial (lo crea "npm run db:setup" en una BD nueva; pide cambiar la clave al entrar) ===
ADMIN_DNI=
ADMIN_PASSWORD=

# === Repositorio de informes ===
SIGLA_ORAJ=GRM/GGR/ORAJ
# Tamaño máximo por PDF. Si lo cambias, ajusta también client_max_body_size en Nginx
MAX_ARCHIVO_MB=10

# === Login ===
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15

# === Servidor ===
# Mismo dominio para web y API (Nginx): dejar vacío
CORS_ORIGIN=
# Hay un proxy (Nginx) delante: la IP real del visitante viene en X-Forwarded-For
TRUST_PROXY=1

# Los PDF van a la carpeta /datos/archivos (volumen "archivos"): ARCHIVOS_DIR lo fija docker-compose.yml.
# NO pongas aquí SUPABASE_* (solo para la mudanza: ver la guía, sección "Mudanza desde Supabase").

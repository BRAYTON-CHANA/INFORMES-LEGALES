# === Servidor Express ===
PORT=3001
# CORS: vacío = mismo origen (lo normal: Express sirve el frontend y, en desarrollo,
# Vite reenvía /api). Solo si el frontend vive en otro dominio: su URL exacta
# (varias separadas por coma). "*" se ignora.
CORS_ORIGIN=
# Segundos que se recuerda si un usuario está activo y sus roles (0 = consultar siempre)
# AUTH_CACHE_SEG=60
# Intentos de login por IP y minuto
# LOGIN_MAX_POR_IP_MINUTO=20

# === Base de datos: Supabase (PostgreSQL) ===
DB_CLIENT=postgres
# Supabase → Project Settings → Database → Connect → "Session pooler" (IPv4, puerto 5432).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la BD (si tiene símbolos, codifícala: @ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Conexiones por instancia (el Session pooler gratuito admite pocas)
# DB_POOL_MAX=5

# === Supabase Storage: los PDF de los informes (bucket privado, lo crea db:setup) ===
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…; la publishable NO sirve).
# Sin SUPABASE_SECRET_KEY los PDF se guardan dentro de la BD (INFORME_ARCHIVOS.CONTENIDO).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=informes

# --- Otra BD (en vez de DATABASE_URL) ---
# PostgreSQL propio: DB_HOST, DB_PORT=5432, DB_DATABASE, DB_USER, DB_PASSWORD, DB_SSL=false
# SQL Server: DB_CLIENT=mssql y
# DB_HOST=localhost
# DB_DATABASE=INFORMES_LEGALES
# DB_USER=app_user
# DB_PASSWORD=cambia_esto
# DB_INSTANCE=SQLEXPRESS
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERT=true
# Para que db:setup cree la BD y el usuario (no aplica a Supabase):
# DB_ADMIN_USER=
# DB_ADMIN_PASSWORD=

# === JWT ===
JWT_SECRET=genera_un_secreto_largo_aleatorio
JWT_EXPIRES_IN=8h

# === Repositorio de informes ===
# Sufijo del código: "INFORME LEGAL N° 001-2026-<SIGLA_ORAJ>"
SIGLA_ORAJ=GRM/GGR/ORAJ
# Tamaño máximo por archivo subido (PDF/DOCX), en MB
MAX_ARCHIVO_MB=25

# === Credenciales (lib/config/credenciales.js): se entra solo con el DNI ===
# Admin inicial que crea npm run db:setup
ADMIN_DNI=12345678
ADMIN_PASSWORD=cambia_esto_tambien
# Bloqueo temporal tras intentos fallidos de login
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15
